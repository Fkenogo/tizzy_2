rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // catalogExercises: readable by all auth users, no client writes
    match /catalogExercises/{exerciseId} {
      allow read: if request.auth != null;
    }
    
    // users: users can read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /favorites/{exerciseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // groups: Anyone can read basic group info to join, but only members see inner details
    match /groups/{groupId} {
      allow read: if request.auth != null; 
      allow create: if request.auth != null 
                    && request.resource.data.members.hasAll([request.auth.uid])
                    && request.resource.data.admins.hasAll([request.auth.uid]);
      allow update: if request.auth != null && request.auth.uid in resource.data.admins;
      
      match /posts/{postId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow update, delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins);
        
        match /comments/{commentId} {
          allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
          allow update, delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins);
        }
      }
    }
    
    // challenges
    match /challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;
      allow create: if request.auth != null 
                    && request.resource.data.status == "pending" 
                    && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && (request.auth.uid in resource.data.challengeAdmins || request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.admins);
      
      match /logs/{logId} {
        allow create: if request.auth != null 
                      && get(/databases/$(database)/documents/challenges/$(challengeId)).data.status == "active"
                      && request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.participants;
        allow read: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.participants);
      }
    }
    
    // donations
    match /donations/{donationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // leaderboards
    match /leaderboards/{type}/{id} {
      allow read: if request.auth != null;
    }
  }
}